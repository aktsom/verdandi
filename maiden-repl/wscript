top = '../..'

def options(opt):
    opt.load('compiler_c compiler_cxx')

def configure(conf):
    conf.load('compiler_c compiler_cxx')

    # libraries with full pkg-config data
    # optional on macOS (homebrew ncurses/readline are keg-only); matron works without it
    mandatory = not conf.env.NORNS_MACOS
    ok = conf.check_cfg(package='ncursesw', args=['--cflags', '--libs'], mandatory=mandatory)
    ok = conf.check_cfg(package='panel', args=['--cflags', '--libs'], mandatory=mandatory) and ok
    ok = conf.check_cfg(package='readline', args=['--cflags', '--libs'], mandatory=mandatory) and ok
    conf.env.HAVE_MAIDEN_REPL = bool(ok)

def build(bld):
    if bld.env.NORNS_MACOS and not bld.env.HAVE_MAIDEN_REPL:
        return
    maiden_repl_sources = [
        'src/io.c',
        'src/msg_queue.c',
        'src/ui.c',
        'src/page.c',
        'src/pages.c',
        'src/main.c',
    ]

    bld.program(features='c cxx cxxprogram',
                source=maiden_repl_sources,
                target='maiden-repl',

                includes=[
                    'src',
                ],
                use=[
                    'NCURSESW',
                    'NNG',
                    'ATOMIC',
                    'PANEL',
                    'READLINE'
                ],
                lib=[
                    'pthread',
                ],
                cxxflags=[
                    '-O2',
                    '-Wall',
                    '-Wextra',
                    '-Werror',
                    '-pedantic'
                ])
