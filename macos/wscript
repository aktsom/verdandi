from waflib.TaskGen import extension

top = '..'

@extension('.m')
def objc_file(self, node):
    # objective-c (app_input.m): a c task, clang compiles it as objective-c by its extension
    return self.create_compiled_task('c', node)

def build(bld):
    bld.program(features='c cprogram',
        source='jack_wait.c',
        target='jack_wait',
        use=['JACK'],
        ldflags=['-Wl,-headerpad_max_install_names'])

    # one source, three tools (argv[0] selects); norns.sh puts this dir on PATH
    for i, tool in enumerate(['jack_connect', 'jack_disconnect', 'jack_lsp']):
        bld.program(features='c cprogram',
            source='jack_tools.c',
            target=tool,
            idx=i + 2,
            use=['JACK'],
            ldflags=['-Wl,-headerpad_max_install_names'])

    # the CoreAudio devices for SYSTEM > AUDIO
    bld.program(features='c cprogram',
        source='audio_devices.c',
        target='audio_devices',
        framework=['CoreAudio', 'CoreFoundation'],
        ldflags=['-Wl,-headerpad_max_install_names'])

    # norns side of the AUv3 (see auv3/auv3_bridge.c)
    bld.program(features='c cprogram',
        source='auv3/auv3_bridge.c',
        target='auv3_bridge',
        includes=['auv3'],
        use=['JACK'],
        lib=['jacknet'],
        framework=['CoreMIDI', 'CoreFoundation'],
        ldflags=['-Wl,-headerpad_max_install_names'])

    # another app's sound as norns' input (Devices > Audio Input from App, see app_input.m)
    bld.program(features='c cprogram',
        source='app_input.m',
        target='app_input',
        use=['JACK'],
        lib=['jacknet'],
        cflags=['-fobjc-arc'],
        framework=['AudioToolbox', 'CoreAudio', 'Foundation'],
        ldflags=['-Wl,-headerpad_max_install_names'])
