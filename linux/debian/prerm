#!/bin/sh
# Verdandi package, before the files are removed (docs/port/phase-m36.md): refused while a program of this installation runs (see preinst). nothing is written, moved or deleted here.
set -e
PROC="${VERDANDI_PROC_DIR:-/proc}"
running() {
    for p in "$PROC"/[0-9]*; do
        exe="$(readlink "$p/exe" 2> /dev/null)" || continue
        case "$exe" in /opt/verdandi/*) return 0 ;; esac
    done
    return 1
}
case "$1" in
    remove | upgrade)
        if running; then
            echo "Verdandi is running. Close Verdandi (quit it from its window) and try again." >&2
            exit 1
        fi
        ;;
esac
exit 0
