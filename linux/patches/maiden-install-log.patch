 // Install installs the project at url if a project with the given name does not already exist in root
 func Install(root, name, srcURL string, entry *catalog.Entry) error {
+	start := time.Now()
+	log.Printf("install: %s from %s into %s", name, srcURL, filepath.Join(root, name))
+	err := install(root, name, srcURL, entry)
+	if err != nil {
+		log.Printf("install: %s FAILED after %v: %v", name, time.Since(start).Round(time.Millisecond), err)
+		return err
+	}
+	log.Printf("install: %s done in %v%s", name, time.Since(start).Round(time.Millisecond), submoduleReport(filepath.Join(root, name)))
+	return nil
+}
