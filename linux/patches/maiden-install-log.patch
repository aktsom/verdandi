+// Verdandi: what an install does is written to the log (maiden.log): the start, the end with the time, the error text when it fails, and which git submodules came with the script
+// (a script that bundles a library as a submodule says something is missing when the folder is empty)
+func submoduleReport(projectPath string) string {
+	data, err := ioutil.ReadFile(filepath.Join(projectPath, ".gitmodules"))
+	if err != nil {
+		return ""
+	}
+	out := ""
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "path") {
+			continue
+		}
+		parts := strings.SplitN(line, "=", 2)
+		if len(parts) != 2 {
+			continue
+		}
+		sub := strings.TrimSpace(parts[1])
+		files := 0
+		filepath.Walk(filepath.Join(projectPath, sub), func(p string, info os.FileInfo, err error) error {
+			if err == nil && info.IsDir() && info.Name() == ".git" {
+				return filepath.SkipDir
+			}
+			if err == nil && !info.IsDir() {
+				files++
+			}
+			return nil
+		})
+		if files == 0 {
+			out += fmt.Sprintf("; submodule %s is EMPTY (it was not fetched: the script may say something is missing)", sub)
+		} else {
+			out += fmt.Sprintf("; submodule %s: %d files", sub, files)
+		}
+	}
+	return out
+}
