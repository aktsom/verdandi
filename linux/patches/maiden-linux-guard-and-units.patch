+func isLoopbackHost(h string) bool {
+	return h == "127.0.0.1" || h == "localhost" || h == "::1"
+}
+
+// loopbackGuard allows a request when its Host is one of the loopback names of this server's port and,
+// if it carries an Origin (browsers send one for cross-site requests, and for every non-GET), that is
+// one of the same names. requests without an Origin (curl, maiden-repl, same-site GET) are fine.
+func loopbackGuard(port int) gin.HandlerFunc {
+	names := []string{"127.0.0.1", "localhost", "[::1]"}
+	ok := map[string]bool{}
+	for _, n := range names {
+		ok[fmt.Sprintf("%s:%d", n, port)] = true
+	}
+	return func(ctx *gin.Context) {
+		if !ok[ctx.Request.Host] {
+			ctx.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": "forbidden: unexpected Host " + ctx.Request.Host})
+			return
+		}
+		if origin := ctx.Request.Header.Get("Origin"); origin != "" && !ok[strings.TrimPrefix(origin, "http://")] {
+			ctx.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": "forbidden: Origin " + origin})
+			return
+		}
+		ctx.Next()
+	}
+}
