+/* Verdandi: the virtual grid and arc of the program that embeds libmonome are an in-process named pipe, \\.\pipe\verdandi-..., given here as "pipe\verdandi-...".
+ * it is not a serial port: no baud rate, no comm mask. everything else (overlapped reads and writes, the protocol on top) is as for a serial port */
+static int m_is_pipe_name(const char *dev) {
+	return strncmp(dev, "pipe\\verdandi-", 14) == 0;
+}
+
+static int m_is_pipe_handle(HANDLE h) {
+	return GetNamedPipeInfo(h, NULL, NULL, NULL, NULL) != 0;
+}
