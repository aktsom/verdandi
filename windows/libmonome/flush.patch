 char *(*monome_platform_serial_hook)(const char *path) = NULL;
 
+/* Verdandi: the bytes written so far are really out of the computer (the program is about to end or close the port). a serial port: FlushFileBuffers waits until the driver has sent its output buffer.
+ * a pipe is not flushed: that would wait for the program on the other side to read it. 0 = done, 1 = the driver said no */
+int monome_platform_flush(monome_t *monome) {
+	HANDLE hres = (HANDLE) _get_osfhandle(monome->fd);
+
+	if (m_is_pipe_handle(hres))
+		return 0;
+
+	return FlushFileBuffers(hres) ? 0 : 1;
+}
